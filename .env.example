# Copy to .env (gitignored) to change settings. Everything here is optional:
# without a .env, `make ci` runs fully locally and pushes to a throwaway registry.
# Values are read by make: no quotes, and write a literal $ as $$.

# JFrog Artifactory. When all three are set, `make ci` publishes to JFrog
# instead of the local registry. ART_URL is the base URL, without /artifactory.
# ART_URL=https://<your-instance>.jfrog.io
# ART_USER=<your-user>
# ART_TOKEN=<access-token>
# ART_DOCKER_REPO=docker-local
# ART_GENERIC_REPO=generic-local

# Force a publish target: local, jfrog or none.
# PUBLISH=local

# Gate policy (UNKNOWN, LOW, MEDIUM, HIGH, CRITICAL, or NONE to disable a rule).
# FAIL_ON_SEVERITY=CRITICAL
# FAIL_ON_FIXABLE_SEVERITY=HIGH

# Port of the throwaway local registry (5000 is often taken by AirPlay on macOS).
# LOCAL_REGISTRY_PORT=5050
