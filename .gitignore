# Python bytecode, virtualenvs and tool caches
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Local configuration (credentials). Copy .env.example to .env.
.env
.env.*
!.env.example

# Pipeline outputs (image tarball, scan results, SBOM, SARIF, gate, reports).
# The tarball and SARIF are also ignored when OUT points somewhere else.
build/
dist/
*.tar
*.sarif

# Scanner cache (Trivy vulnerability DB)
.cache/

# Old revision file. The tag now comes from git; never commit it.
.rev

# Runtime and editor files
*.log
*.pid
*.tmp
*.swp
*~
.DS_Store
.idea/
.vscode/
